# Server-only: Next.js route handlers proxy to API Gateway. The browser calls /api/* only — do not put this URL in NEXT_PUBLIC_* (that would ship it to the client).
API_BASE_URL=https://xxxxxxxx.execute-api.ap-southeast-1.amazonaws.com
# Shared with backend Lambda `signupBootstrap` — used to create the initial DynamoDB row after Cognito sign-up
SIGNUP_BOOTSTRAP_SECRET=generate-a-long-random-string

# In client code, read these only as process.env.NEXT_PUBLIC_* (static property). Dynamic process.env[name] is not inlined in the browser bundle.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_DOMAIN=your-domain.auth.ap-southeast-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000/auth/sign-in
# Optional: public base URL for profile photos (S3 key is appended). Example: https://your-cdn.cloudfront.net
# NEXT_PUBLIC_PROFILE_MEDIA_BASE_URL=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_DESKTOP_LEFT=1111111111
NEXT_PUBLIC_ADSENSE_SLOT_DESKTOP_RIGHT=2222222222
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_INLINE=3333333333
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_BOTTOM=4444444444
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNIN_LEFT=5555555555
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNIN_RIGHT=6666666666
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNUP_LEFT=7777777777
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNUP_RIGHT=8888888888
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNIN_MOBILE_TOP=9999999991
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNIN_MOBILE_BOTTOM=9999999992
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNUP_MOBILE_TOP=9999999993
NEXT_PUBLIC_ADSENSE_SLOT_AUTH_SIGNUP_MOBILE_BOTTOM=9999999994
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT_DESKTOP_LEFT=9999999995
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT_DESKTOP_RIGHT=9999999996
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT_MOBILE_INLINE_0=9999999990
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT_MOBILE_INLINE_1=9999999997
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT_MOBILE_INLINE_2=9999999998
NEXT_PUBLIC_ADSENSE_SLOT_CONTACT_DESKTOP_LEFT=9999999985
NEXT_PUBLIC_ADSENSE_SLOT_CONTACT_DESKTOP_RIGHT=9999999986
NEXT_PUBLIC_ADSENSE_SLOT_CONTACT_MOBILE_INLINE=9999999987
